{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/getto-dev/check-data/main/schema/dataset.schema.json",
  "title": "CHECK Profession Dataset",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "locale", "currency"],
  "properties": {
    "schemaVersion": {"type": "integer", "minimum": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "minLength": 2},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "unit", "priceKopecks", "categoryId"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "unit": {"type": "string", "minLength": 1},
          "priceKopecks": {"type": "integer", "minimum": 0},
          "categoryId": {"type": "string", "minLength": 1},
          "type": {"enum": ["service", "material"]}
        },
        "additionalProperties": false
      }
    },
    "synonyms": {},
    "config": {}
  },
  "additionalProperties": false
}
